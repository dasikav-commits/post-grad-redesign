# Wayamba University — Postgraduate Portal
# Copy this file to .env and fill in the values.
#
#   cp .env.example .env
#   openssl rand -base64 32        # → SESSION_SECRET

# --- Database (required) ----------------------------------------------------
# Supabase POOLED connection (port 6543) used by the app at runtime.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true&connection_limit=1"

# Supabase SESSION connection (port 5432) used by the Prisma CLI / migrations.
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# --- Auth (required) --------------------------------------------------------
# Used to sign the session cookie. Generate with: openssl rand -base64 32
# src/lib/auth.ts throws on every request if this is missing.
SESSION_SECRET=""

# --- Email links (needed for links in notification emails) ------------------
# In a Codespace use the forwarded public URL of the dev server.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- File uploads (needed for the registration wizard's file uploads) -------
# Files go to the "registration-files" bucket (created on first use).
NEXT_PUBLIC_SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""

# --- SMTP (optional) --------------------------------------------------------
# Without SMTP credentials every email is printed to the dev-server console and
# the workflow still runs.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM=""
